# Copy to .env and fill in. Never commit .env.

# --- Application -------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
# Log full prompts and model output at DEBUG level. Rejected in production.
LOG_PROMPTS=false
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/generative_ui
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Language models ---------------------------------------------------------
# groq | cohere
DEFAULT_LLM_PROVIDER=groq
# Comma-separated providers tried, in order, when the default fails (e.g. "cohere").
LLM_FALLBACK_PROVIDERS=cohere
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
# How many times invalid model output is sent back for correction (0-3).
LLM_MAX_REPAIR_ATTEMPTS=2

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

# Extra attempts per provider for transient failures (timeouts, HTTP 429, HTTP 5xx).
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=0.5

# --- Identity and access -------------------------------------------------------
# Require sign-in (email + password, bearer tokens). Must be true in production.
AUTH_REQUIRED=true
# Signs access tokens. Required in production (32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=720
# Requests per minute per caller (0 disables). Counted per application process.
RATE_LIMIT_PER_MINUTE=240
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Data sources ----------------------------------------------------------------
DATA_SOURCE_TIMEOUT_SECONDS=10
# Let REST data sources call private/loopback addresses. Development only.
DATA_SOURCE_ALLOW_PRIVATE_HOSTS=false
# Secrets referenced by data sources (`credentials_ref`) are read from variables named
# DATASOURCE_SECRET_<REFERENCE>, e.g. for credentials_ref "WAREHOUSE":
# DATASOURCE_SECRET_WAREHOUSE=postgresql://readonly:password@db.internal:5432/sales

# --- Search (optional; enables the "search" action) ----------------------------
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- Application generation -----------------------------------------------------
# A whole application takes many model calls. These bound its size and pace.
APP_MAX_SCREENS=10
APP_RECORDS_PER_ENTITY=10
# Screens designed at the same time. Use 1 on rate-limited model plans.
APP_SCREEN_CONCURRENCY=2
# Design-review passes that may regenerate weak screens (0 turns refinement off).
APP_REFINEMENT_PASSES=1
APP_GENERATION_MAX_OUTPUT_TOKENS=6000
# Generation stages write long answers and get a longer timeout than LLM_TIMEOUT_SECONDS.
APP_GENERATION_TIMEOUT_SECONDS=120
# When every provider is rate-limited or slow, wait (at least this long, longer if the
# provider asks) and retry this many times. Small free plans need the patience.
LLM_RATE_LIMIT_RETRIES=5
LLM_RATE_LIMIT_WAIT_SECONDS=10

# --- Images ---------------------------------------------------------------------
# Images per generated application; 0 turns imagery off.
APP_MAX_ASSETS=8
# Text-to-image: "pollinations" (public endpoint, no key) or "none".
# Image prompts derived from the user's idea are sent to this provider.
# Reference component library: only needed for `scripts.import_references twenty_first`.
# Create a key at https://21st.dev/mcp. The open-source sources need no key.
TWENTYFIRST_API_KEY=

IMAGE_GENERATION_PROVIDER=pollinations
# Photograph search: "auto" (Unsplash if a key is set, else Openverse), "unsplash",
# "openverse" (no key) or "none". Only the search words are sent.
IMAGE_SEARCH_PROVIDER=auto
UNSPLASH_ACCESS_KEY=
ASSET_TIMEOUT_SECONDS=45
# With both providers off, images are drawn locally from the theme colours.

# --- Demo data ---------------------------------------------------------------
# Development-only mock sales dataset. Defaults to on outside production;
# must not be true in production.
ENABLE_MOCK_DATA=true

# --- Tests ---------------------------------------------------------------------
# Database used (and wiped) by the integration tests.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/generative_ui_test
